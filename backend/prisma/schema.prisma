generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}
enum JobQueueStatus {
 PENDING
 PROCESSING
 COMPLETED
 FAILED
 CANCELLED
}

enum ParseStatus {
  PENDING
  DONE
  FAILED
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String
  password String
  role     UserRole @default(USER)

  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes Resume[]
  jobs    Job[]
  jobQueues JobQueue[]

  @@index([role])
  @@index([createdAt])
  @@index([email])
  @@map("users")
}

model Resume {
  id         String   @id @default(cuid())
  fileName   String
  fileBuffer Bytes?
  fileSize   Int
  localPath  String?
  mimeType   String
  uploadedAt DateTime @default(now())

  parseStatus ParseStatus @default(PENDING)
  parsedAt    DateTime?

  name       String?
  email      String?
  phone      String?
  skills     String[]
  experience Int? @default(0)
  education  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matches JobMatch[]

  @@index([userId])
  @@index([parseStatus])
  @@index([uploadedAt])
  @@index([experience])
  @@index([skills])
  @@index([name])
  @@index([email])
  @@map("resumes")
}

model Job {
  id           String   @id @default(cuid())
  title        String
  description  String
  requirements String
  skills       String[]
  experience   Int?
  education    String?
  location     String?
  salary       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  matches JobMatch[]
  jobQueues JobQueue[]

  @@index([title])
  @@index([skills])
  @@index([experience])
  @@index([education])
  @@index([location])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("jobs")
}

model JobMatch {
  id       String @id @default(cuid())
  jobId    String
  resumeId String

  overallMatchScore     Float?
  skillsMatchScore      Float?
  experienceMatchScore  Float?
  educationMatchScore   Float?
  culturalFitMatchScore Float?
  technicalMatchScore   Float?
  biasMatchScore        Float?

  matchedSkills   String[]
  missingSkills   String[]
  experienceGap   Int?
  educationMatch  String?
  aiMatchInsights String?

  matchedAt DateTime @default(now())

  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([jobId, resumeId])
  @@index([jobId])
  @@index([resumeId])
  @@index([overallMatchScore])
  @@index([skillsMatchScore])
  @@index([experienceMatchScore])
  @@index([matchedAt])
  @@map("job_matches")
}

model JobQueue {
 id            String          @id @default(cuid())
  jobId         String
  userId        String
  status        JobQueueStatus  @default(PENDING)
  topN          Int?
  weights       Json?
  insightsTopK  Int?            @default(5)
  createdAt     DateTime        @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  resultData    Json?
  errorMessage  String?

  job   Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([jobId])
  @@map("job_queue")

}
